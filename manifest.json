          },
          "data": {
            "type": "array",
            "description": "Alias of result."
          },
          "count": {
            "type": "number",
            "description": "Number of channels when array."
          },
          "error": {
            "type": "string",
            "description": "Error message when failed."
          }
        }
      },
      "title": "Buzz List Channels",
      "description": "List Buzz channels visible to this agent identity. Wraps: buzz channels list."
    },
    {
      "type": "buzz-check-membership",
      "entryPoint": "./buzz-check-membership.js",
      "title": "Buzz Check Membership",
      "description": "Check whether the agent is a member of a channel, or list membership status across channels.",
      "schema": {
        "title": "Buzz Check Membership",
        "category": "action",
        "type": "buzz-check-membership",
        "icon": "user-check",
        "description": "Check whether the current agent identity is a member of a given channel, or list membership status across all channels. Wraps: buzz channels list.",
        "parameters": {
          "channel": {
            "type": "string",
            "inputType": "text",
            "description": "Channel UUID to check. Omit to list status across all channels.",
            "required": false
          },
          "allChannels": {
            "type": "boolean",
            "inputType": "checkbox",
            "description": "Return the full status map even when a channel is given.",
            "required": false
          },
          "relayUrl": {
            "type": "string",
            "inputType": "text",
            "description": "Override BUZZ_RELAY_URL for this call.",
            "required": false
          },
          "privateKey": {
            "type": "string",
            "inputType": "text",
            "description": "Override the agent private key for this call.",
            "required": false
          },
          "buzzBin": {
            "type": "string",
            "inputType": "text",
            "description": "Override the buzz binary path.",
            "required": false
          },
          "timeoutMs": {
            "type": "number",
            "inputType": "number",
            "description": "CLI timeout in ms (default 60000).",
            "required": false
          }
        }
      }
    },
    {
      "type": "buzz-join-channel",
