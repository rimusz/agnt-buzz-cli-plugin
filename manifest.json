{
  "name": "buzz-cli-plugin",
  "version": "1.4.5",
  "description": "Buzz (Block Nostr workspace) via official buzz CLI. After install: set BUZZ_RELAY_URL + BUZZ_BIN, create AGNT agent, provision identity (tool buzz-provision-identity or script), assign buzz_* tools. See docs/CONNECT-ANY-AGENT.md. Per-agent keys; tools never return private keys. Optional real-time listener companion (listener/) makes the agent auto-reply to DMs/mentions in ~3s.",
  "author": "AGNT",
  "icon": "message-square",
  "homepage": "https://github.com/block/buzz",
  "tools": [
    {
      "type": "buzz-send-message",
      "entryPoint": "./buzz-send-message.js",
      "schema": {
        "title": "Buzz Send Message",
        "category": "action",
        "type": "buzz-send-message",
        "icon": "send",
        "description": "Send a message to a Buzz channel. Supports reply-to (thread) and optional broadcast. Wraps: buzz messages send.",
        "parameters": {
          "channel": {
            "type": "string",
            "inputType": "text",
            "description": "Channel UUID to post into.",
            "required": true
          },
          "content": {
            "type": "string",
            "inputType": "textarea",
            "description": "Message body (markdown/plain). Long bodies are piped via stdin.",
            "required": true
          },
          "replyTo": {
            "type": "string",
            "inputType": "text",
            "description": "Optional parent event id to reply in a thread.",
            "required": false
          },
          "broadcast": {
            "type": "boolean",
            "inputType": "checkbox",
            "description": "Pass --broadcast to the CLI when true.",
            "required": false,
            "default": false
          },
          "relayUrl": {
            "type": "string",
            "inputType": "text",
            "description": "Override BUZZ_RELAY_URL for this call (e.g. https://relay.example.com).",
            "required": false
          },
          "privateKey": {
            "type": "string",
            "inputType": "password",
            "description": "Escape-hatch nsec override. Prefer per-agent registry (~/.agnt/buzz-identities). Shared BUZZ_PRIVATE_KEY is disabled by default.",
            "required": false
          },
          "buzzBin": {
            "type": "string",
            "inputType": "text",
            "description": "Optional path to the buzz binary (default: PATH or BUZZ_BIN).",
            "required": false
          },
          "timeoutMs": {
            "type": "number",
            "inputType": "number",
            "description": "CLI timeout in milliseconds (default 60000).",
            "required": false,
            "default": 60000
          },
          "agentId": {
            "type": "string",
            "inputType": "text",
            "description": "AGNT agent UUID for identity lookup. Usually injected from chat context automatically.",
            "required": false
          }
        },
        "outputs": {
          "success": {
            "type": "boolean",
            "description": "Whether the CLI exited 0."
          },
          "result": {
            "type": "object",
            "description": "Parsed JSON from buzz stdout (sent message event)."
          },
          "data": {
            "type": "object",
            "description": "Alias of result for chaining."
          },
          "channel": {
            "type": "string",
            "description": "Channel UUID used."
          },
          "replyTo": {
            "type": "string",
            "description": "Parent event id if any."
          },
          "error": {
            "type": "string",
            "description": "Error message when success is false."
          }
        }
      },
      "title": "Buzz Send Message",
      "description": "Send a message to a Buzz channel. Supports reply-to (thread) and optional broadcast. Wraps: buzz messages send."
    },
    {
      "type": "buzz-get-messages",
      "entryPoint": "./buzz-get-messages.js",
      "schema": {
        "title": "Buzz Get Messages",
        "category": "action",
        "type": "buzz-get-messages",
        "icon": "inbox",
        "description": "Fetch recent messages from a Buzz channel. Wraps: buzz messages get.",
        "parameters": {
          "channel": {
            "type": "string",
            "inputType": "text",
            "description": "Channel UUID.",
            "required": true
          },
          "limit": {
            "type": "number",
            "inputType": "number",
            "description": "Max messages to return (default 20).",
            "required": false,
            "default": 20,
            "minimum": 1,
            "maximum": 500
          },
          "relayUrl": {
            "type": "string",
            "inputType": "text",
            "description": "Override BUZZ_RELAY_URL.",
            "required": false
          },
          "privateKey": {
            "type": "string",
            "inputType": "password",
            "description": "Escape-hatch nsec override. Prefer per-agent registry (~/.agnt/buzz-identities). Shared BUZZ_PRIVATE_KEY is disabled by default.",
            "required": false
          },
          "buzzBin": {
            "type": "string",
            "inputType": "text",
            "description": "Optional path to buzz binary.",
            "required": false
          },
          "timeoutMs": {
            "type": "number",
            "inputType": "number",
            "description": "CLI timeout ms.",
            "required": false,
            "default": 60000
          },
          "agentId": {
            "type": "string",
            "inputType": "text",
            "description": "AGNT agent UUID for identity lookup. Usually injected from chat context automatically.",
            "required": false
          }
        },
        "outputs": {
          "success": {
            "type": "boolean",
            "description": "Whether the CLI exited 0."
          },
          "result": {
            "type": "array",
            "description": "Message list (parsed JSON)."
          },
          "data": {
            "type": "array",
            "description": "Alias of result."
          },
          "count": {
            "type": "number",
            "description": "Number of messages returned when array."
          },
          "channel": {
            "type": "string",
            "description": "Channel UUID used."
          },
          "error": {
            "type": "string",
            "description": "Error message when failed."
          }
        }
      },
      "title": "Buzz Get Messages",
      "description": "Fetch recent messages from a Buzz channel. Wraps: buzz messages get."
    },
    {
      "type": "buzz-list-channels",
      "entryPoint": "./buzz-list-channels.js",
      "schema": {
