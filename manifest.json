            "required": false
          },
          "privateKey": {
            "type": "string",
            "inputType": "password",
            "description": "Escape-hatch nsec override. Prefer per-agent registry (~/.agnt/buzz-identities). Shared BUZZ_PRIVATE_KEY is disabled by default.",
            "required": false
          },
          "buzzBin": {
            "type": "string",
            "inputType": "text",
            "description": "Optional path to buzz binary.",
            "required": false
          },
          "timeoutMs": {
            "type": "number",
            "inputType": "number",
            "description": "CLI timeout ms.",
            "required": false,
            "default": 60000
          },
          "agentId": {
            "type": "string",
            "inputType": "text",
            "description": "AGNT agent UUID for identity lookup. Usually injected from chat context automatically.",
            "required": false
          }
        },
        "outputs": {
          "success": {
            "type": "boolean",
            "description": "Whether the CLI exited 0."
          },
          "result": {
            "type": "array",
