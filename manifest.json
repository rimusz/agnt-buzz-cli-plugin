    {
      "type": "buzz-provision-identity",
      "entryPoint": "./buzz-provision-identity.js",
      "schema": {
        "title": "Buzz Provision Identity",
        "category": "action",
        "type": "buzz-provision-identity",
        "icon": "key",
        "description": "Generate, report, or rotate a per-agent Buzz (Nostr) identity. Returns PUBLIC keys only (npub + hex) — never the private key. Set rotate:true to safely rotate an existing identity.",
        "parameters": {
          "agentId": {
            "type": "string",
            "inputType": "text",
            "description": "AGNT agent UUID to bind (required unless only listing own — must pass target agent id).",
            "required": true
          },
          "name": {
            "type": "string",
            "inputType": "text",
            "description": "Agent/bot name for the Buzz identity (e.g. SalesBot).",
            "required": true
          },
